def merge_sort(arr):
    if len(arr) > 1:
        mid = len(arr) // 2

        left = arr[:mid]
        right = arr[mid:]

        merge_sort(left)
        merge_sort(right)

        i = j = k = 0

        # Merge the two sorted halves
        while i < len(left) and j < len(right):
            if left[i] <= right[j]:
                arr[k] = left[i]
                i += 1
            else:
                arr[k] = right[j]
                j += 1
            k += 1

        # Copy remaining elements from left
        while i < len(left):
            arr[k] = left[i]
            i += 1
            k += 1

        # Copy remaining elements from right
        while j < len(right):
            arr[k] = right[j]
            j += 1
            k += 1


# Main program
orders = list(map(int, input("Enter delivery times in minutes: ").split()))

print("Original delivery times:", orders)

merge_sort(orders)

print("Orders sorted by delivery time:", orders)
